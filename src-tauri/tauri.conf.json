{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JohnBot",
  "version": "0.1.0",
  "identifier": "com.johndeere.johnbot",
  "build": {
    "beforeDevCommand": "bun run dev:next",
    "devUrl": "http://localhost:3000",
    "frontendDist": "desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JohnBot",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "runtime/compose.yaml": "runtime/compose.yaml"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
