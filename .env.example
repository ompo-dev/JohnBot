# Runtime configuration. Copy to .env for local use; never commit it.
JOHNBOT_PORT=3000
JOHNBOT_LOG_LEVEL=info
JOHNBOT_WORKER_CONCURRENCY=4
JOHNBOT_DATA_MODE=postgres

# Host development (compose.dev.yaml publishes databases on loopback only).
# Uncomment for Next/Prisma running on the host, not in Compose:
# DATABASE_URL=postgresql://johnbot:johnbot_dev_only@127.0.0.1:5432/johnbot
REDIS_URL=redis://127.0.0.1:6379
# Compose containers use `postgres:5432` by default. To override their database, set
# JOHNBOT_DATABASE_URL; do not export host DATABASE_URL into Compose.
# If changed, update the password in the connection string too. Defaults are local demo only.
POSTGRES_PASSWORD=johnbot_dev_only

# External integrations are server-only. Keep tokens out of NEXT_PUBLIC_* values.
# JOHNBOT_A2A_ENDPOINTS=[{"id":"planning-agent","url":"https://agent.example.com"}]
# JOHNBOT_AUTO_ONTOLOGY_URL=https://ontology.example.com
# JOHNBOT_AUTO_ONTOLOGY_TOKEN=replace-with-a-server-side-secret

# Dashboard generation uses an OpenAI-compatible model configured only on the server.
# Without model/key the simulation creates an explicitly labeled local preview.
# JOHNBOT_DASHBOARD_MODEL=your-model-id
# JOHNBOT_DASHBOARD_API_KEY=your-server-side-key
# JOHNBOT_DASHBOARD_BASE_URL=https://api.openai.com/v1
