# Copie para .env. O arquivo .env é ignorado pelo Git.
POSTGRES_HOST=auto-ontology-postgres
POSTGRES_PORT=5432
POSTGRES_USER=auto_ontology
POSTGRES_PASSWORD=generate-a-local-secret
POSTGRES_DATABASE=auto_ontology
PGADMIN_EMAIL=admin@johnbot.local
PGADMIN_PASSWORD=generate-a-local-secret
AUTO_ONTOLOGY_ADMIN_EMAIL=admin@johnbot.local
AUTO_ONTOLOGY_ADMIN_PASSWORD=generate-a-local-secret
AUTH_SECRET=generate-a-64-character-local-secret
APP_URL=http://localhost:3100
AUTO_ONTOLOGY_MCP_PUBLIC_URL=http://localhost:3103
INGESTION_SERVICE_URL=http://ingestion-service:3002
DEFAULT_MODELS_ENDPOINT=https://integrate.api.nvidia.com/v1
DEFAULT_MODELS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
# Chaves emitidas pelo provedor; não podem ser geradas pelo projeto.
DEFAULT_MODELS_API_KEY=
REASONING_API_KEY=
NON_REASONING_API_KEY=
EMBED_API_KEY=
RERANK_API_KEY=
# Conexão de uma fonte de dados explicitamente autorizada.
CONNECTION_STRINGS=
