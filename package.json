  "scripts": {
    "prepare": "node scripts/setup-husky.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import-redis": "bun scripts/db/import-redis.ts",
    "test:database": "bun tests/integration/database.test.ts",
    "worker": "bun src/workers/background.worker.ts",
    "test:jobs": "bun tests/integration/jobs.test.ts",
    "test:data-store": "bun tests/unit/data-store.test.ts",
    "dev": "prisma generate && next dev",
    "build": "node scripts/build-mode.mjs server",
    "build:next": "node scripts/build-mode.mjs server",
    "build:standalone": "node scripts/build-mode.mjs standalone",
    "build:static": "node scripts/build-mode.mjs static",
    "lint": "node scripts/run-lint.mjs && biome lint .github/scripts .husky/test-hooks.mjs",
    "lint:fix": "node scripts/run-lint.mjs --write",
    "format:check": "biome format package.json tsconfig.base.json next.config.ts biome.jsonc scripts/run-lint.mjs scripts/check-staged.mjs scripts/setup-husky.mjs scripts/build-mode.mjs .husky/test-hooks.mjs .github/scripts/test-style-fixture.mjs",
    "check": "bun run lint && bun run format:check && bun run check:architecture",
    "check:architecture": "bun scripts/check-architecture.mjs",
    "test:unit": "bun tests/unit/run.ts",
    "test:operations:ui": "bun tests/regression/operations-ui.test.tsx",
    "test:dashboard:ui": "bun test tests/regression/dashboard-program.test.tsx && bun tests/regression/person-settings.test.tsx",
    "test:operations:http": "bun tests/integration/operations.test.ts",
    "test:routines-ui": "bun tests/regression/menu-compat.test.tsx --app --upstream --url --routines",
    "styles:generate": "node scripts/migrate-styles-faithfully.mjs --write",
    "styles:check": "node scripts/check-original-styles.mjs && node scripts/migrate-styles-faithfully.mjs",
    "test:react-compat": "bun tests/regression/menu-compat.test.tsx --app",
    "test:upstream": "bun tests/regression/menu-compat.test.tsx --app --upstream",
    "test:url-state": "bun tests/regression/menu-compat.test.tsx --app --upstream --url",
    "test:data-stack": "bun tests/integration/data-stack.test.ts",
    "test:domains": "bun tests/integration/domains.ts",
    "start": "next start",
    "start:static": "bun scripts/serve.ts",
    "dev:next": "prisma generate && next dev",
    "preview": "bun scripts/serve.ts",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
